// The shard function's first row is a single instruction (a tail call), so its
// entry breakpoint coincides with the row's terminal.  Tracing a shard must
// still record that row, rather than treating it as an entry-only breakpoint.
input data(c:u16) -> (b:u8)
memory ram[u32](addr:u16) -> (b:u8)

fn main<ram>() {
    var n:u16 = data[0] as u16
    //
    step!(0, n)
}

#[global]
fn step<ram>(i:u16, n:u16) -> ! {
    work!(i, n)
}

fn work<ram>(i:u16, n:u16) -> ! {
    ram[i] = data[i + 1]
    //
    if (i + 1) == n {
        done
    }
    //
    step!(i + 1, n)
}
