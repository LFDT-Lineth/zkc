// The shard function begins with a loop, so its first instruction is also the
// loop head.  Checkpointing must still pivot on entries to the shard function,
// identically for the interpreter and gogen, rather than on every iteration.
input data(c:u16) -> (b:u8)
memory ram[u32](addr:u16) -> (b:u8)

fn main<ram>() {
    var n:u16 = data[0] as u16
    //
    count!(0, n)
}

#[global]
fn count<ram>(i:u16, n:u16) -> ! {
    while ram[i] != data[i + 1] {
        ram[i] = ram[i] + 1
    }
    //
    if (i + 1) == n {
        done
    }
    //
    count!(i + 1, n)
}
