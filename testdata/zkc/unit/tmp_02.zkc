fn f(x:u32) -> (y:u32) {
    var b_case_1:u1 = x == 1 ? 1:0
    var b_case_2:u1 = x == 2 ? 1:0
    var b_case_3:u1 = x == 3 ? 1:0
    var b_case_default:u1 = (1 - (b_case_1 + b_case_2 + b_case_3) as u1)

    if (b_case_1 == 1) {
        y = 0
        return
    }
    if b_case_2 == 1 {
        y = 0
        return
    }
    if b_case_3 == 1 {
        y = 0
        return
    }
    if b_case_default == 1 {
        y = x
        return
    }
    fail
}
