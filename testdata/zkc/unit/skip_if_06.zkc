// Regression test (KNOWN LIMITATION -- see t.Skip below): a long chain of
// non-foldable, input-dependent XOR operations inflates the per-operation
// range-check codegen enough, under a small max-static-height, that a
// hoisted conditional-skip target overflows the u16 relative-offset bound of
// the general SkipIf encoding (see encodeSkipIf_rcv in
// pkg/zkc/vm/internal/interpreter/encoding/skip_if.go), which panics rather
// than falling back to a wider form.  This is independent of, and was
// discovered whilst isolating, the wide multiway-skip (SKIP_M) fix -- see
// switch_18.
input inputs(c:u1) -> (d:u8)
input outputs(c:u1) -> (out:u32)

fn main() {
    var acc:u32 = inputs[0] as u32

    acc = acc ^ 0x10000
    acc = acc ^ 0x10001
    acc = acc ^ 0x10002
    acc = acc ^ 0x10003
    acc = acc ^ 0x10004
    acc = acc ^ 0x10005
    acc = acc ^ 0x10006
    acc = acc ^ 0x10007
    acc = acc ^ 0x10008
    acc = acc ^ 0x10009
