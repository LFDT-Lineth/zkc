// Read-feeds-write on the same address: a single statement both reads and
// writes the memory, so it carries two timestamps.
// Code lines: main = 1, inc = 1 (one trace row per invocation).
pub input data(address:u8) -> (byte:u8)
memory ram[u32](address:u8) -> (byte:u8)

fn inc<ram>(x:u8) {
    ram[x] = ram[x] + 1
}

fn main<ram>() {
    var addr:u8 = data[0]
    var start:u8 = data[1]
    var expected:u8 = data[2]
    ram[addr] = start
    inc(addr)
    inc(addr)
    inc(addr)
    if ram[addr] != expected {
        fail
    }
}
