pub input data(address:u8) -> (word:u16)
pub output out(address:u8) -> (word:u16)
pub output wide(address:u8) -> (word:u16)

// Test WIDE_CSUB instruction
// - via constant wider than a byte
// - via a wide register
fn main() {
    var x:u16 = data[0]
    // 
    var res:u16 = 0x100 - x
    out[0] = res
    //
    wide[0] = three_minus_r255(x)
}

