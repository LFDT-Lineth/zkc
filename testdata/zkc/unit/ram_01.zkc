// A one-line effectful function: a single read, reached through a call which
// threads the memory's timestamp in and out.
// Code lines: main = 1, get = 1 (one trace row per invocation).
pub input data(address:u8) -> (byte:u8)
memory ram[u32](address:u8) -> (byte:u8)

fn get<ram>(x:u8) -> (r:u8) {
    r = ram[x]
}

fn main<ram>() {
    var addr:u8 = data[0]
    var value:u8 = data[1]
    ram[addr] = value
    if get(addr) != value {
        fail
    }
}
