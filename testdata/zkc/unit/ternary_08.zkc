pub input data(address:u8) -> (byte:u8)

fn main() {
    var cond:u8 = data[0]
    var exp_nested:u8 = data[1]

    // Diamond shape is : skip_if (cond) S ; {jmp/skip/fail}...

    // Nested if: outer skip is control-only.
    // Diamond shape here has S=2, body is a nested if so it's a control-only body. Do not factorableSkips.
    var z:u8 = 0
    if cond != 0 {
        if cond == 1 {
            z = 1
        } else {
            z = 2
        }
    } else {
        z = 0
    }
    if z != exp_nested {
        fail
    }
}
