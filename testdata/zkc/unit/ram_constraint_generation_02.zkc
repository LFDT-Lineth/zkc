// Constraint-generation test: read-write memory with a multi-lane (tuple) value.
pub input data(address:u16) -> (lhs:u16, rhs:u16)
memory ram(addr:u16) -> (a:u16, b:u16)

fn main<ram>() {
    var x:u16, y:u16
    ram[0] = data[0]
    ram[1] = data[1]
    x, y = ram[0]
    if x == y {
        fail
    }
    return
}
