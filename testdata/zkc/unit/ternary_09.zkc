pub input data(address:u8) -> (byte:u8)

fn main() {
    var cond:u8 = data[0]
    var expected_z:u8 = data[1]
    var expected_a:u8 = data[2]
    var z:u8
    var a:u8 = 0

    // S=2 diamond whose middle is jmp (then-arm has a later statement), not
    // skip 1: FactorSkipConditions must not wrap this.
    if cond != 0 {
        z = 1
        a = a + 1
    } else {
        z = 0
    }

    if z != expected_z {
        fail
    }
    if a != expected_a {
        fail
    }
    return
}
