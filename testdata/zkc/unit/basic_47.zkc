pub input data(address:u16) -> (word:u64)

fn main() {
    var lhs:u64 = data[0]
    var rhs:u64 = data[1]
    var res:u64 = data[2]
    //
    if max(lhs,rhs) != res {
        fail
    }
}

fn max(v:u64, w:u64) -> (r:u64) {
    var b:u1
    var tmp:u64
    //
    b::tmp = (v as u65) - (w as u65)
    //
    if b == 1 {
       r = w
    } else {
       r = v
    }
}
