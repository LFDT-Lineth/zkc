pub input data(address:u16) -> (word:u8)

// Subtraction from a constant (CSUB).  Inputs are a and b, followed by the
// expected value of each case.
fn main() {
    var a:u8 = data[0]
    var b:u8 = data[1]
    // CSUB_1c1n cases
    var csub_1c1n_case0:u8 = 3 - a
    var csub_1c1n_case1:u8 = 3 - a - 2

    // CSUB_nm cases
    var csub_2n1m:u8 = 3 - a - b
    var csub_1n2m_0:u4
    var csub_1n2m_1:u4
    csub_1n2m_1::csub_1n2m_0 = 171 - a
    //
    if csub_1c1n_case0 != data[2] {
        fail
    } else if csub_1c1n_case1 != data[3] {
        fail
    } else if csub_2n1m != data[4] {
        fail
    } else if (csub_1n2m_1 as u8) != data[5] {
        fail
    } else if (csub_1n2m_0 as u8) != data[6] {
        fail
    }
}
