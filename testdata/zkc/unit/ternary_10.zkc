pub input data(address:u8) -> (byte:u8)

fn main() {
    var cond:u8 = data[0]
    var expected:u8 = data[1]
    var z:u8 = 0

    // The outer SkipIf skips three control instructions.  Its body has no
    // shared writes, so FactorSkipConditions must not materialise another bit.
    if cond != 0 {
        if cond == 1 {
            z = 1
        } else {
            z = 2
        }
    } else {
        z = 0
    }

    if z != expected {
        fail
    }
    return
}
