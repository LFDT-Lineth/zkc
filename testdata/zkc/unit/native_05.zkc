// Test for a native function with several return

pub input data(address:u1) -> (word:u8)

#[native]
fn copy(x:u8) -> (y:u8) {
    if x == 0 {
        y = 0
        return
    }
    if x == 1 {
        y = 1
        return
    }

    y = x
    return
}

fn main() {
    var x:u8 = data[0]
    var r:u8 = copy(x)

    if (r != x) {
        fail
    }
}