input data(addr:u16) -> (b:u8)

fn main() {
    var n:u16 = data[0]::data[1]
    checkNonZero!(n)
}

fn checkNonZero(n:u16) -> ! {
    var tmp:u16 = n
    //
    if tmp == 0 {
        done
    } else if data[n + 1] == 0 {
        fail
    }
    // Force multiline function
    tmp = tmp - 1
    //
    checkNonZero!(tmp)
}
