pub input data(address:u1) -> (word:u64)
pub input expected(address:u1) -> (val:u8)

fn main() {
    var x:u64 = data[0]
    var r:u8
    // compare against constants whose limbs are either all zeroes or all
    // ones, such that the lowering can group the limb comparisons of each
    // branch condition into a single constraint.
    if x == 0xFFFFFFFFFFFFFFFF {
        r = 1
    } else if x == 0x00000000FFFFFFFF {
        r = 2
    } else if x != 0 {
        r = 3
    } else {
        r = 0
    }
    //
    if r != expected[0] {
        fail
    }
    return
}
