pub input data(address:u32) -> (word:u32)

fn main() {
    var x:u32 = data[0]
    var y:u32 = data[1]
    var z:u32 = data[2]
    var res:u32 = data[3]
    //
    if mulmod(x, y, z) != res {
        fail
    }
}

fn mulmod(x:u32, y:u32, m:u32) -> (r:u32) {
    var tmp:u64 = ((x as u64) * (y as u64)) % (m as u64)
    //
    r = tmp as u32
}
