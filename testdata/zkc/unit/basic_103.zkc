pub input data(address:u3) -> (word:u64)

fn main() {
    var x:u26 = data[0] as u26
    var y:u40 = data[1] as u40
    var a_exp:u1 = data[2] as u1
    var b_exp:u40 = data[3] as u40
    var c_exp:u25 = data[4] as u25
    //
    var a:u1
    var b:u40
    var c:u25
    c::b::a = y::x
    //
    if a != a_exp || b != b_exp || c != c_exp {
        fail
    }
}
