pub input data(address:u8) -> (v:u32)

// Combined division / remainder ("/%") with a register divisor, checked
// against the plain "/" and "%" operators and the expected inputs.  Operands
// are u32 so that register splitting is exercised on narrow fields.

fn main() {
    var x:u32 = data[0]
    var y:u32 = data[1]

    var q_exp:u32 = data[2]
    var r_exp:u32 = data[3]

    var q:u32 = 0
    var r:u32 = 0

    q, r = x /% y

    var q_straight:u32 = x / y
    var r_straight:u32 = x % y

    if q != q_straight {
        fail
    }

    if q != q_exp {
        fail
    }

    if r != r_straight {
        fail
    }

    if r != r_exp {
        fail
    }

    return
}
