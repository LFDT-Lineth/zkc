pub input data(address:u16) -> (word:u32)
pub output result(address:u16) -> (word:u32)

// Convert a wide uint into the field modulo P, compare it as a field element,
// then extract its canonical uint representative.
fn main() {
    var v:u32 = data[0]
    var expected:u32 = data[1]
    var f:𝔽 = v as 𝔽
    var same:𝔽 = f as 𝔽
    var b:u32 = f as u32
    //
    if same != (expected as 𝔽) {
        fail
    }

    result[0] = b
}
