pub input data(address:u16) -> (word:u32)
pub output result(address:u16) -> (word:u32)

// Exercise modular uint→field conversion and canonical field→uint extraction
// across a function boundary.
fn main() {
    var value:u32 = data[0]
    result[0] = canonicalise(value as 𝔽)
}

fn canonicalise(value:𝔽) -> (result:u32) {
    result = value as u32
    return
}
