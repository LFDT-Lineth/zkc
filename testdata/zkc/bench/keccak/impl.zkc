include "constants.zkc"
include "utils.zkc"
include "memory.zkc"
include "write.zkc"
include "type.zkc"
include "keccakf.zkc"

// Implementation of the keccak hash function
// - state size = 1600 bits
// - little endian inputs

// ===================================================================
// Keccak-f[1600] parameters and constants
// ===================================================================

// 5x5xW state with W = 64 (5x5x64 = 1600 bits)
type lane = u64

// ===================================================================
// Main function
// ===================================================================

fn keccak<ram, keccak_state>(msg_address:Address, msg_length:u32, output_address:Address) {

    // remove any leftovers from previous keccak computations
    wipe_state()

    printf "\n"
    printf "msg_address: %x\n", msg_address
    printf "msg_length: %x\n", msg_length
    printf "output_address: %x\n", output_address

    absorbing_phase(msg_address, msg_length)

    squeezing_phase(output_address)

    print_hash()
}

// print_hash prints the hash in BIG-ENDIAN convention
#[debug]
fn print_hash<keccak_state>() {
    printf "\nkeccak hash:\t"
    print_big_endian(keccak_state[ROW0])
    print_big_endian(keccak_state[ROW1])
    print_big_endian(keccak_state[ROW2])
    print_big_endian(keccak_state[ROW3])
    printf "\n"

}
// print_big_endian prints a u64 in BIG-ENDIAN convention
#[debug]
fn print_big_endian(val:u64) {
    var b7:u8, b6:u8, b5:u8, b4:u8, b3:u8, b2:u8, b1:u8, b0:u8
    b7::b6::b5::b4::b3::b2::b1::b0 = val
    printf "%x%x%x%x%x%x%x%x", b0, b1, b2, b3, b4, b5, b6, b7
}

fn wipe_state<keccak_state>() {
    for i:u7 = 0; i<5; i = i + 1 {
        keccak_state[ROW0 + i] = 0
        keccak_state[ROW1 + i] = 0
        keccak_state[ROW2 + i] = 0
        keccak_state[ROW3 + i] = 0
        keccak_state[ROW4 + i] = 0
    }
}

// ===================================================================
// Sponge absorption and squeezing phases
// ===================================================================

// Xor the input blocks into the state and perform the permutation
fn absorbing_phase<ram, keccak_state>(msg_address:Address, msg_length:u32) {

    var n_blocks:u32 = (msg_length / BLOCK_BYTE_LENGTH) + 1
    var remainder:u8 = (msg_length % BLOCK_BYTE_LENGTH) as u8

    var curr_address:Address = msg_address

    // =======================================================================================
    // building full blocks (no padding), XORing them into the state,
    // and calling keccak_f
    // =======================================================================================

    // we build the blocks that DO NOT require padding and call keccak_f on them
    // NOTE: n_blocks ≥ 1
    for block:u32 = 0; block<(n_blocks - 1); block = block + 1 {
        for limb:u5 = 0; limb<17; limb = limb + 1 {
            keccak_state[PIB + (limb as u7)] = read_64(curr_address + (8 * (limb as Address)))
        }

        xor_padded_input_block_into_state()
        keccak_f()

        curr_address = curr_address + (BLOCK_BYTE_LENGTH as Address)
    }

    // =======================================================================================
    // building the final padded block, XORing it into the state,
    // and calling keccak_f
    // =======================================================================================

    // final block, DOES require padding --- always
    // n_full_words ∈ {0, 1, ..., 16}
    var n_full_words:u5 = (remainder / 8) as u5
    var n_bytes:u3 = (remainder % 8) as u3

    var final_word_in_block:u1
    if n_full_words == 16 {
        final_word_in_block = 1
    } else {
        final_word_in_block = 0
    }

    for limb:u5 = 0; limb<n_full_words; limb = limb + 1 {
        keccak_state[PIB + (limb as u7)] = read_64(curr_address + (8 * (limb as Address)))
    }
    curr_address = curr_address + (8 * (n_full_words as Address))
    keccak_state[PIB + (n_full_words as u7)] = read_and_pad_64(curr_address, n_bytes, final_word_in_block)

    // the code below should only trigger if n_full_words < 16 = 17 - 1
    // the above "read_and_pad_64" call didn't fill the final word, so
    // more padding happens: zero words followed by a terminating 1
    if final_word_in_block != 1 {
        for limb:u5 = n_full_words + 1; limb<16; limb = limb + 1 {
            keccak_state[PIB + (limb as u7)] = 0
        }
        keccak_state[PIB + 16] = FINAL_RIGHT_PADDING
    }

    xor_padded_input_block_into_state()
    keccak_f()
}

// xor_padded_input_block_into_state does exactly what its name suggests
fn xor_padded_input_block_into_state<keccak_state>() {
    keccak_state[ROW0] = keccak_state[ROW0] ^ keccak_state[PIB]
    keccak_state[ROW1] = keccak_state[ROW1] ^ keccak_state[PIB + 1]
    keccak_state[ROW2] = keccak_state[ROW2] ^ keccak_state[PIB + 2]
    keccak_state[ROW3] = keccak_state[ROW3] ^ keccak_state[PIB + 3]
    keccak_state[ROW4] = keccak_state[ROW4] ^ keccak_state[PIB + 4]
    keccak_state[ROW0 + 1] = keccak_state[ROW0 + 1] ^ keccak_state[PIB + 5]
    keccak_state[ROW1 + 1] = keccak_state[ROW1 + 1] ^ keccak_state[PIB + 6]
    keccak_state[ROW2 + 1] = keccak_state[ROW2 + 1] ^ keccak_state[PIB + 7]
    keccak_state[ROW3 + 1] = keccak_state[ROW3 + 1] ^ keccak_state[PIB + 8]
    keccak_state[ROW4 + 1] = keccak_state[ROW4 + 1] ^ keccak_state[PIB + 9]
    keccak_state[ROW0 + 2] = keccak_state[ROW0 + 2] ^ keccak_state[PIB + 10]
    keccak_state[ROW1 + 2] = keccak_state[ROW1 + 2] ^ keccak_state[PIB + 11]
    keccak_state[ROW2 + 2] = keccak_state[ROW2 + 2] ^ keccak_state[PIB + 12]
    keccak_state[ROW3 + 2] = keccak_state[ROW3 + 2] ^ keccak_state[PIB + 13]
    keccak_state[ROW4 + 2] = keccak_state[ROW4 + 2] ^ keccak_state[PIB + 14]
    keccak_state[ROW0 + 3] = keccak_state[ROW0 + 3] ^ keccak_state[PIB + 15]
    keccak_state[ROW1 + 3] = keccak_state[ROW1 + 3] ^ keccak_state[PIB + 16]
}

fn squeezing_phase<ram, keccak_state>(output_address:Address) {
    write_64(output_address + (0 * 8), keccak_state[ROW0] as u64)
    write_64(output_address + (1 * 8), keccak_state[ROW1] as u64)
    write_64(output_address + (2 * 8), keccak_state[ROW2] as u64)
    write_64(output_address + (3 * 8), keccak_state[ROW3] as u64)
}

// ===================================================================
// The Keccak-f permutation
// ===================================================================

// keccak_f applies the Keccak-f[1600] permutation to the state held in keccak_state.
// Lane (x, y) lives at keccak_state[ROWx + y] and is element x+5y of the array passed to
// keccakF1600.
fn keccak_f<keccak_state>() {
    var a:[lane;25]
    var b0:u64, b1:u64, b2:u64, b3:u64, b4:u64
    var b5:u64, b6:u64, b7:u64, b8:u64, b9:u64
    var b10:u64, b11:u64, b12:u64, b13:u64, b14:u64
    var b15:u64, b16:u64, b17:u64, b18:u64, b19:u64
    var b20:u64, b21:u64, b22:u64, b23:u64, b24:u64
    // Read out state
    a[0] = keccak_state[ROW0]
    a[1] = keccak_state[ROW1]
    a[2] = keccak_state[ROW2]
    a[3] = keccak_state[ROW3]
    a[4] = keccak_state[ROW4]
    a[5] = keccak_state[ROW0 + 1]
    a[6] = keccak_state[ROW1 + 1]
    a[7] = keccak_state[ROW2 + 1]
    a[8] = keccak_state[ROW3 + 1]
    a[9] = keccak_state[ROW4 + 1]
    a[10] = keccak_state[ROW0 + 2]
    a[11] = keccak_state[ROW1 + 2]
    a[12] = keccak_state[ROW2 + 2]
    a[13] = keccak_state[ROW3 + 2]
    a[14] = keccak_state[ROW4 + 2]
    a[15] = keccak_state[ROW0 + 3]
    a[16] = keccak_state[ROW1 + 3]
    a[17] = keccak_state[ROW2 + 3]
    a[18] = keccak_state[ROW3 + 3]
    a[19] = keccak_state[ROW4 + 3]
    a[20] = keccak_state[ROW0 + 4]
    a[21] = keccak_state[ROW1 + 4]
    a[22] = keccak_state[ROW2 + 4]
    a[23] = keccak_state[ROW3 + 4]
    a[24] = keccak_state[ROW4 + 4]
    // Apply permutation
    b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24 = keccakF1600(a)
    // Write back state
    keccak_state[ROW0] = b0
    keccak_state[ROW1] = b1
    keccak_state[ROW2] = b2
    keccak_state[ROW3] = b3
    keccak_state[ROW4] = b4
    keccak_state[ROW0 + 1] = b5
    keccak_state[ROW1 + 1] = b6
    keccak_state[ROW2 + 1] = b7
    keccak_state[ROW3 + 1] = b8
    keccak_state[ROW4 + 1] = b9
    keccak_state[ROW0 + 2] = b10
    keccak_state[ROW1 + 2] = b11
    keccak_state[ROW2 + 2] = b12
    keccak_state[ROW3 + 2] = b13
    keccak_state[ROW4 + 2] = b14
    keccak_state[ROW0 + 3] = b15
    keccak_state[ROW1 + 3] = b16
    keccak_state[ROW2 + 3] = b17
    keccak_state[ROW3 + 3] = b18
    keccak_state[ROW4 + 3] = b19
    keccak_state[ROW0 + 4] = b20
    keccak_state[ROW1 + 4] = b21
    keccak_state[ROW2 + 4] = b22
    keccak_state[ROW3 + 4] = b23
    keccak_state[ROW4 + 4] = b24
}
