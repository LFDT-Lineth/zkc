include "constants.zkc"
include "utils.zkc"
include "memory.zkc"
include "state.zkc"
include "write.zkc"
include "type.zkc"

// Implementation of the keccak hash function
// - state size = 1600 bits
// - little endian inputs
//
// NARROW-CALL VARIANT: the 25 state lanes live in the keccak_state memory
// between rounds; keccak_round reads them once into locals, computes the
// fully fused round (theta, rho, pi, chi, iota) in registers, and writes
// them back.  Function signatures stay narrow (1 argument), at the cost of
// 50 state-memory accesses per round.  As in the wide variant, the keccak
// padding is applied to the message in place, in ram, so the final block is
// absorbed by exactly the same code as every full block.
//
// NOTE: keccak writes the padding into ram in the [msg_length, block boundary)
// range immediately after the message; that range must be free for it to use.
//
// See impl_wide.zkc for the register-threaded twin, and keep the two in
// sync when touching the round logic.

// ===================================================================
// Keccak-f[1600] parameters and constants
// ===================================================================

// 5x5xW state with W = 64 (5x5x64 = 1600 bits)
type lane = u64

// KECCAK_ROUNDS = number of rounds = 12 + 2 * l with 2^l = W
const KECCAK_ROUNDS:u5 = 24

// ===================================================================
// Main function
// ===================================================================

fn keccak<ram, keccak_state>(msg_address:Address, msg_length:u32, output_address:Address) {

    // remove any leftovers from previous keccak computations
    wipe_state()

    printf "\n"
    printf "msg_address: %x\n", msg_address
    printf "msg_length: %x\n", msg_length
    printf "output_address: %x\n", output_address

    absorbing_phase(msg_length, msg_address)

    squeezing_phase(output_address)

    print_hash()
}

// print_hash prints the digest in the standard keccak hex order
#[debug]
fn print_hash<keccak_state>() {
    printf "\nkeccak hash:\t"
    print_lane(keccak_state[ROW0])
    print_lane(keccak_state[ROW1])
    print_lane(keccak_state[ROW2])
    print_lane(keccak_state[ROW3])
    printf "\n"

}
// print_lane prints the eight bytes of a state lane least-significant-first,
// which is the little-endian serialisation keccak specifies for the digest.
#[debug]
fn print_lane(val:u64) {
    var b7:u8, b6:u8, b5:u8, b4:u8, b3:u8, b2:u8, b1:u8, b0:u8
    b7::b6::b5::b4::b3::b2::b1::b0 = val
    printf "%02x%02x%02x%02x%02x%02x%02x%02x", b0, b1, b2, b3, b4, b5, b6, b7
}

fn wipe_state<keccak_state>() {
    for i:u7 = 0; i<5; i = i + 1 {
        keccak_state[ROW0 + i] = 0
        keccak_state[ROW1 + i] = 0
        keccak_state[ROW2 + i] = 0
        keccak_state[ROW3 + i] = 0
        keccak_state[ROW4 + i] = 0
    }
}

// ===================================================================
// Sponge absorption and squeezing phases
// ===================================================================

// Xor the input blocks into the state and perform the permutation
fn absorbing_phase<ram, keccak_state>(msg_length:u32, msg_address:Address) {

    var curr_address:Address = msg_address

    // =======================================================================================
    // absorbing the blocks that DO NOT require padding
    // =======================================================================================

    // NOTE: no division — the loop guard replaces `msg_length / 136`, and what
    // is left in `remaining` afterwards replaces `msg_length % 136`; the loop
    // paid a comparison per block either way.
    var remaining:u32 = msg_length
    while remaining >= BLOCK_BYTE_LENGTH {
        absorb_block(curr_address)

        curr_address = curr_address + (BLOCK_BYTE_LENGTH as Address)
        remaining = remaining - BLOCK_BYTE_LENGTH
    }

    // =======================================================================================
    // absorbing the final padded block (always present)
    // =======================================================================================

    // Pad the tail of the message in place so the final block can go through
    // absorb_block unchanged.  remaining < 136, so `/% 8` is just a bit split:
    // top 5 bits :: low 3 bits.
    var n_full_words:u5
    var n_bytes:u3
    n_full_words::n_bytes = (remaining as u8)

    var final_word_in_block:u1 = n_full_words == 16 ? 1:0

    // the word straddling the end of the message keeps its message bytes and
    // gains the 0x01 (and, if it is the last word of the block, the 0x80).
    var pad_address:Address = curr_address + (8 * (n_full_words as Address))
    write_64(pad_address, read_and_pad_64(pad_address, n_bytes, final_word_in_block))

    // the code below should only trigger if n_full_words < 16 = 17 - 1
    // the above "read_and_pad_64" call didn't fill the final word, so
    // more padding happens: zero words followed by a terminating 1
    if final_word_in_block != 1 {
        for limb:u8 = (n_full_words as u8) + 1; limb<16; limb = limb + 1 {
            pad_address = pad_address + 8
            write_64(pad_address, 0)
        }
        write_64(curr_address + 128, FINAL_RIGHT_PADDING)
    }

    absorb_block(curr_address)
}

// absorb_block XORs the 17 rate lanes of the block at `base` into the state
// and then applies the full Keccak-f[1600] permutation.  Block lane i is
// A[i%5][i/5].
fn absorb_block<ram, keccak_state>(base:Address) {
    keccak_state[ROW0] = keccak_state[ROW0] ^ read_64(base)
    keccak_state[ROW1] = keccak_state[ROW1] ^ read_64(base + 8)
    keccak_state[ROW2] = keccak_state[ROW2] ^ read_64(base + 16)
    keccak_state[ROW3] = keccak_state[ROW3] ^ read_64(base + 24)
    keccak_state[ROW4] = keccak_state[ROW4] ^ read_64(base + 32)
    keccak_state[ROW0 + 1] = keccak_state[ROW0 + 1] ^ read_64(base + 40)
    keccak_state[ROW1 + 1] = keccak_state[ROW1 + 1] ^ read_64(base + 48)
    keccak_state[ROW2 + 1] = keccak_state[ROW2 + 1] ^ read_64(base + 56)
    keccak_state[ROW3 + 1] = keccak_state[ROW3 + 1] ^ read_64(base + 64)
    keccak_state[ROW4 + 1] = keccak_state[ROW4 + 1] ^ read_64(base + 72)
    keccak_state[ROW0 + 2] = keccak_state[ROW0 + 2] ^ read_64(base + 80)
    keccak_state[ROW1 + 2] = keccak_state[ROW1 + 2] ^ read_64(base + 88)
    keccak_state[ROW2 + 2] = keccak_state[ROW2 + 2] ^ read_64(base + 96)
    keccak_state[ROW3 + 2] = keccak_state[ROW3 + 2] ^ read_64(base + 104)
    keccak_state[ROW4 + 2] = keccak_state[ROW4 + 2] ^ read_64(base + 112)
    keccak_state[ROW0 + 3] = keccak_state[ROW0 + 3] ^ read_64(base + 120)
    keccak_state[ROW1 + 3] = keccak_state[ROW1 + 3] ^ read_64(base + 128)

    keccak_f()
}

fn squeezing_phase<ram, keccak_state>(output_address:Address) {
    write_64(output_address + (0 * 8), keccak_state[ROW0] as u64)
    write_64(output_address + (1 * 8), keccak_state[ROW1] as u64)
    write_64(output_address + (2 * 8), keccak_state[ROW2] as u64)
    write_64(output_address + (3 * 8), keccak_state[ROW3] as u64)
}

// ===================================================================
// The Keccak-f permutation
// ===================================================================

fn keccak_f<keccak_state>() {
    for j:u5 = 0; j<KECCAK_ROUNDS; j = j + 1 {
        var round_constant:u64 = RC[j]
        keccak_round(round_constant)
    }
}

// KECCAK ROUND (fully fused): theta, rho, pi, chi, iota in one pass.
// The 25 state lanes are read once, all intermediates (C, D, B) live
// in locals, and the 25 results are written back once.
fn keccak_round<keccak_state>(round_constant:u64) {

    // ---- load state lanes A[x][y] (x = row, y = column) ----
    var a00:u64 = keccak_state[ROW0]
    var a01:u64 = keccak_state[ROW0 + 1]
    var a02:u64 = keccak_state[ROW0 + 2]
    var a03:u64 = keccak_state[ROW0 + 3]
    var a04:u64 = keccak_state[ROW0 + 4]
    var a10:u64 = keccak_state[ROW1]
    var a11:u64 = keccak_state[ROW1 + 1]
    var a12:u64 = keccak_state[ROW1 + 2]
    var a13:u64 = keccak_state[ROW1 + 3]
    var a14:u64 = keccak_state[ROW1 + 4]
    var a20:u64 = keccak_state[ROW2]
    var a21:u64 = keccak_state[ROW2 + 1]
    var a22:u64 = keccak_state[ROW2 + 2]
    var a23:u64 = keccak_state[ROW2 + 3]
    var a24:u64 = keccak_state[ROW2 + 4]
    var a30:u64 = keccak_state[ROW3]
    var a31:u64 = keccak_state[ROW3 + 1]
    var a32:u64 = keccak_state[ROW3 + 2]
    var a33:u64 = keccak_state[ROW3 + 3]
    var a34:u64 = keccak_state[ROW3 + 4]
    var a40:u64 = keccak_state[ROW4]
    var a41:u64 = keccak_state[ROW4 + 1]
    var a42:u64 = keccak_state[ROW4 + 2]
    var a43:u64 = keccak_state[ROW4 + 3]
    var a44:u64 = keccak_state[ROW4 + 4]

    // ---- theta: column parities C, then D = C[x-1] ^ rotl1(C[x+1]) ----
    var c0:u64 = a00 ^ a01 ^ a02 ^ a03 ^ a04
    var c1:u64 = a10 ^ a11 ^ a12 ^ a13 ^ a14
    var c2:u64 = a20 ^ a21 ^ a22 ^ a23 ^ a24
    var c3:u64 = a30 ^ a31 ^ a32 ^ a33 ^ a34
    var c4:u64 = a40 ^ a41 ^ a42 ^ a43 ^ a44

    var t1h:u1, t1l:u63
    t1h::t1l = c2
    var d1:u64 = c0 ^ (t1l::t1h)
    var t2h:u1, t2l:u63
    t2h::t2l = c3
    var d2:u64 = c1 ^ (t2l::t2h)
    var t3h:u1, t3l:u63
    t3h::t3l = c4
    var d3:u64 = c2 ^ (t3l::t3h)
    var t4h:u1, t4l:u63
    t4h::t4l = c0
    var d4:u64 = c3 ^ (t4l::t4h)
    var t0h:u1, t0l:u63
    t0h::t0l = c1
    var d0:u64 = c4 ^ (t0l::t0h)

    // ---- rho + pi: B[y][(2x+3y)%5] = rotl(A[x][y] ^ D[x], r[x][y]) ----
    var b00:u64 = a00 ^ d0
    var r36h:u36, r36l:u28
    r36h::r36l = a01 ^ d0
    var b13:u64 = r36l::r36h
    var r3h:u3, r3l:u61
    r3h::r3l = a02 ^ d0
    var b21:u64 = r3l::r3h
    var r41h:u41, r41l:u23
    r41h::r41l = a03 ^ d0
    var b34:u64 = r41l::r41h
    var r18h:u18, r18l:u46
    r18h::r18l = a04 ^ d0
    var b42:u64 = r18l::r18h
    var r1h:u1, r1l:u63
    r1h::r1l = a10 ^ d1
    var b02:u64 = r1l::r1h
    var r44h:u44, r44l:u20
    r44h::r44l = a11 ^ d1
    var b10:u64 = r44l::r44h
    var r10h:u10, r10l:u54
    r10h::r10l = a12 ^ d1
    var b23:u64 = r10l::r10h
    var r45h:u45, r45l:u19
    r45h::r45l = a13 ^ d1
    var b31:u64 = r45l::r45h
    var r2h:u2, r2l:u62
    r2h::r2l = a14 ^ d1
    var b44:u64 = r2l::r2h
    var r62h:u62, r62l:u2
    r62h::r62l = a20 ^ d2
    var b04:u64 = r62l::r62h
    var r6h:u6, r6l:u58
    r6h::r6l = a21 ^ d2
    var b12:u64 = r6l::r6h
    var r43h:u43, r43l:u21
    r43h::r43l = a22 ^ d2
    var b20:u64 = r43l::r43h
    var r15h:u15, r15m:u34, r15b:u15
    r15h::r15m::r15b = a23 ^ d2
    var b33:u64 = r15m::r15b::r15h
    var r61h:u61, r61l:u3
    r61h::r61l = a24 ^ d2
    var b41:u64 = r61l::r61h
    var r28h:u28, r28l:u36
    r28h::r28l = a30 ^ d3
    var b01:u64 = r28l::r28h
    var r55h:u55, r55l:u9
    r55h::r55l = a31 ^ d3
    var b14:u64 = r55l::r55h
    var r25h:u25, r25l:u39
    r25h::r25l = a32 ^ d3
    var b22:u64 = r25l::r25h
    var r21h:u21, r21l:u43
    r21h::r21l = a33 ^ d3
    var b30:u64 = r21l::r21h
    var r56h:u56, r56l:u8
    r56h::r56l = a34 ^ d3
    var b43:u64 = r56l::r56h
    var r27h:u27, r27l:u37
    r27h::r27l = a40 ^ d4
    var b03:u64 = r27l::r27h
    var r20h:u20, r20l:u44
    r20h::r20l = a41 ^ d4
    var b11:u64 = r20l::r20h
    var r39h:u39, r39l:u25
    r39h::r39l = a42 ^ d4
    var b24:u64 = r39l::r39h
    var r8h:u8, r8l:u56
    r8h::r8l = a43 ^ d4
    var b32:u64 = r8l::r8h
    var r14h:u14, r14l:u50
    r14h::r14l = a44 ^ d4
    var b40:u64 = r14l::r14h

    // ---- chi (+ iota on lane [0][0]): A = B ^ (~B[x+1] & B[x+2]) ----
    keccak_state[ROW0] = (b00 ^ ((~b10) & b20)) ^ round_constant
    keccak_state[ROW0 + 1] = (b01 ^ ((~b11) & b21))
    keccak_state[ROW0 + 2] = (b02 ^ ((~b12) & b22))
    keccak_state[ROW0 + 3] = (b03 ^ ((~b13) & b23))
    keccak_state[ROW0 + 4] = (b04 ^ ((~b14) & b24))
    keccak_state[ROW1] = (b10 ^ ((~b20) & b30))
    keccak_state[ROW1 + 1] = (b11 ^ ((~b21) & b31))
    keccak_state[ROW1 + 2] = (b12 ^ ((~b22) & b32))
    keccak_state[ROW1 + 3] = (b13 ^ ((~b23) & b33))
    keccak_state[ROW1 + 4] = (b14 ^ ((~b24) & b34))
    keccak_state[ROW2] = (b20 ^ ((~b30) & b40))
    keccak_state[ROW2 + 1] = (b21 ^ ((~b31) & b41))
    keccak_state[ROW2 + 2] = (b22 ^ ((~b32) & b42))
    keccak_state[ROW2 + 3] = (b23 ^ ((~b33) & b43))
    keccak_state[ROW2 + 4] = (b24 ^ ((~b34) & b44))
    keccak_state[ROW3] = (b30 ^ ((~b40) & b00))
    keccak_state[ROW3 + 1] = (b31 ^ ((~b41) & b01))
    keccak_state[ROW3 + 2] = (b32 ^ ((~b42) & b02))
    keccak_state[ROW3 + 3] = (b33 ^ ((~b43) & b03))
    keccak_state[ROW3 + 4] = (b34 ^ ((~b44) & b04))
    keccak_state[ROW4] = (b40 ^ ((~b00) & b10))
    keccak_state[ROW4 + 1] = (b41 ^ ((~b01) & b11))
    keccak_state[ROW4 + 2] = (b42 ^ ((~b02) & b12))
    keccak_state[ROW4 + 3] = (b43 ^ ((~b03) & b13))
    keccak_state[ROW4 + 4] = (b44 ^ ((~b04) & b14))
}

