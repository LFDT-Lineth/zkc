// Keccak-f[1600] permutation.  Lane (x, y) is element N = x+5y of the state array; the step
// functions take and return the 25 lanes as individual u64 values.  See keccak_f in impl.zkc for the caller.

// keccakRC[round] is the iota round constant.
static keccakRC(round:u5) -> (rc:u64) {
    0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000,
    0x000000000000808B, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
    0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A,
    0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003,
    0x8000000000008002, 0x8000000000000080, 0x000000000000800A, 0x800000008000000A,
    0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008
}

// keccakRot[5x+y] is the rho rotation of lane (x, y), laid out column by column so that each
// column's five rotations are contiguous.
static keccakRot(address:u5) -> (rot:u6) {
    0, 36, 3, 41, 18,
    1, 44, 10, 45, 2,
    62, 6, 43, 15, 61,
    28, 55, 25, 21, 56,
    27, 20, 39, 8, 14
}

// keccakF1600 applies the 24-round Keccak-f[1600] permutation.
fn keccakF1600(a:[u64;25]) -> (b0:u64, b1:u64, b2:u64, b3:u64, b4:u64, b5:u64, b6:u64, b7:u64, b8:u64, b9:u64, b10:u64, b11:u64, b12:u64, b13:u64, b14:u64, b15:u64, b16:u64, b17:u64, b18:u64, b19:u64, b20:u64, b21:u64, b22:u64, b23:u64, b24:u64) {
    // Assign incoming state
    b0 = a[0]
    b1 = a[1]
    b2 = a[2]
    b3 = a[3]
    b4 = a[4]
    b5 = a[5]
    b6 = a[6]
    b7 = a[7]
    b8 = a[8]
    b9 = a[9]
    b10 = a[10]
    b11 = a[11]
    b12 = a[12]
    b13 = a[13]
    b14 = a[14]
    b15 = a[15]
    b16 = a[16]
    b17 = a[17]
    b18 = a[18]
    b19 = a[19]
    b20 = a[20]
    b21 = a[21]
    b22 = a[22]
    b23 = a[23]
    b24 = a[24]
    // Apply 24 rounds
    for round:u5 = 0; round<24; round = round + 1 {
        b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24 = theta(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24)
        b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24 = rhoPi(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24)
        b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24 = chi(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24)
        // iota
        b0 = b0 ^ keccakRC[round]
    }
}

// theta XORs each lane with the parities of its two neighbouring columns.
#[inline]
fn theta(a0:u64, a1:u64, a2:u64, a3:u64, a4:u64, a5:u64, a6:u64, a7:u64, a8:u64, a9:u64, a10:u64, a11:u64, a12:u64, a13:u64, a14:u64, a15:u64, a16:u64, a17:u64, a18:u64, a19:u64, a20:u64, a21:u64, a22:u64, a23:u64, a24:u64) -> (b0:u64, b1:u64, b2:u64, b3:u64, b4:u64, b5:u64, b6:u64, b7:u64, b8:u64, b9:u64, b10:u64, b11:u64, b12:u64, b13:u64, b14:u64, b15:u64, b16:u64, b17:u64, b18:u64, b19:u64, b20:u64, b21:u64, b22:u64, b23:u64, b24:u64) {
    var c0:u64 = xor5(a0, a5, a10, a15, a20)
    var c1:u64 = xor5(a1, a6, a11, a16, a21)
    var c2:u64 = xor5(a2, a7, a12, a17, a22)
    var c3:u64 = xor5(a3, a8, a13, a18, a23)
    var c4:u64 = xor5(a4, a9, a14, a19, a24)

    b0, b5, b10, b15, b20 = thetaColumn(a0, a5, a10, a15, a20, c4, c1)
    b1, b6, b11, b16, b21 = thetaColumn(a1, a6, a11, a16, a21, c0, c2)
    b2, b7, b12, b17, b22 = thetaColumn(a2, a7, a12, a17, a22, c1, c3)
    b3, b8, b13, b18, b23 = thetaColumn(a3, a8, a13, a18, a23, c2, c4)
    b4, b9, b14, b19, b24 = thetaColumn(a4, a9, a14, a19, a24, c3, c0)
}

// thetaColumn XORs each of the five lanes of a column with d = cPrev ^ rotl(cNext, 1), where
// cPrev and cNext are the parities of the columns to the left and right.
fn thetaColumn(a0:u64, a1:u64, a2:u64, a3:u64, a4:u64, cPrev:u64, cNext:u64) -> (b0:u64, b1:u64, b2:u64, b3:u64, b4:u64) {
    var d:u64 = cPrev ^ rotl64(cNext, 1)
    b0 = a0 ^ d
    b1 = a1 ^ d
    b2 = a2 ^ d
    b3 = a3 ^ d
    b4 = a4 ^ d
}

// xor5 returns the XOR of five lanes, i.e. the parity of a column.
fn xor5(a0:u64, a1:u64, a2:u64, a3:u64, a4:u64) -> (r:u64) {
    r = a0 ^ a1 ^ a2 ^ a3 ^ a4
}

// rhoPi rotates each lane (rho) and permutes lane positions (pi): b[y, 2x+3y] = rot(a[x, y]).
// Each statement handles one source column x.
#[inline]
fn rhoPi(a0:u64, a1:u64, a2:u64, a3:u64, a4:u64, a5:u64, a6:u64, a7:u64, a8:u64, a9:u64, a10:u64, a11:u64, a12:u64, a13:u64, a14:u64, a15:u64, a16:u64, a17:u64, a18:u64, a19:u64, a20:u64, a21:u64, a22:u64, a23:u64, a24:u64) -> (b0:u64, b1:u64, b2:u64, b3:u64, b4:u64, b5:u64, b6:u64, b7:u64, b8:u64, b9:u64, b10:u64, b11:u64, b12:u64, b13:u64, b14:u64, b15:u64, b16:u64, b17:u64, b18:u64, b19:u64, b20:u64, b21:u64, b22:u64, b23:u64, b24:u64) {
    b0, b16, b7, b23, b14 = rhoPiColumn(a0, a5, a10, a15, a20, 0)
    b10, b1, b17, b8, b24 = rhoPiColumn(a1, a6, a11, a16, a21, 5)
    b20, b11, b2, b18, b9 = rhoPiColumn(a2, a7, a12, a17, a22, 10)
    b5, b21, b12, b3, b19 = rhoPiColumn(a3, a8, a13, a18, a23, 15)
    b15, b6, b22, b13, b4 = rhoPiColumn(a4, a9, a14, a19, a24, 20)
}

// rhoPiColumn rotates the five lanes of one column by keccakRot[off..off+5].
fn rhoPiColumn(a0:u64, a1:u64, a2:u64, a3:u64, a4:u64, off:u5) -> (b0:u64, b1:u64, b2:u64, b3:u64, b4:u64) {
    b0 = rotl64(a0, keccakRot[off])
    b1 = rotl64(a1, keccakRot[off + 1])
    b2 = rotl64(a2, keccakRot[off + 2])
    b3 = rotl64(a3, keccakRot[off + 3])
    b4 = rotl64(a4, keccakRot[off + 4])
}

// chi applies the non-linear row mixing: a[x, y] = b[x, y] ^ (^b[x+1, y] & b[x+2, y]).
// Each statement handles one row y.
#[inline]
fn chi(b0:u64, b1:u64, b2:u64, b3:u64, b4:u64, b5:u64, b6:u64, b7:u64, b8:u64, b9:u64, b10:u64, b11:u64, b12:u64, b13:u64, b14:u64, b15:u64, b16:u64, b17:u64, b18:u64, b19:u64, b20:u64, b21:u64, b22:u64, b23:u64, b24:u64) -> (a0:u64, a1:u64, a2:u64, a3:u64, a4:u64, a5:u64, a6:u64, a7:u64, a8:u64, a9:u64, a10:u64, a11:u64, a12:u64, a13:u64, a14:u64, a15:u64, a16:u64, a17:u64, a18:u64, a19:u64, a20:u64, a21:u64, a22:u64, a23:u64, a24:u64) {
    a0, a1, a2, a3, a4 = chiRow(b0, b1, b2, b3, b4)
    a5, a6, a7, a8, a9 = chiRow(b5, b6, b7, b8, b9)
    a10, a11, a12, a13, a14 = chiRow(b10, b11, b12, b13, b14)
    a15, a16, a17, a18, a19 = chiRow(b15, b16, b17, b18, b19)
    a20, a21, a22, a23, a24 = chiRow(b20, b21, b22, b23, b24)
}

// chiRow mixes the five lanes of one row: out[x] = b[x] ^ (^b[x+1] & b[x+2]), indices mod 5.
fn chiRow(b0:u64, b1:u64, b2:u64, b3:u64, b4:u64) -> (a0:u64, a1:u64, a2:u64, a3:u64, a4:u64) {
    a0 = b0 ^ ((~b1) & b2)
    a1 = b1 ^ ((~b2) & b3)
    a2 = b2 ^ ((~b3) & b4)
    a3 = b3 ^ ((~b4) & b0)
    a4 = b4 ^ ((~b0) & b1)
}

// rotl64 rotates word left by n bits.
fn rotl64(word:u64, n:u6) -> (res:u64) {
    var shift:u7 = 64 - (n as u7)
    res = (word << n) | (word >> shift)
}
