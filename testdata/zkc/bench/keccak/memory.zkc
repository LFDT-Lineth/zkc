include "type.zkc"

// Represents the available Random Access Memory (RAM) for the guest program.
// This will act as the program memory space and will contain, amongst other things,
// the program executable itself and all data coming from loadable sections of the ELF
// (e.g., .data, .rodata).
#[paged]
memory ram[u32](address:Address) -> (word:u32)

// keccak related memory: the 5x5 state rows live in 8-aligned regions (5
// slots used per region) followed by the 17-lane padded input block at PIB.
// The permutation itself runs in registers (see keccakf.zkc).
memory keccak_state[u32](address:u7) -> (state:lane)
const ROW0:u7 = 0
const ROW1:u7 = 8
const ROW2:u7 = 16
const ROW3:u7 = 24
const ROW4:u7 = 32
const PIB:u7 = 96
