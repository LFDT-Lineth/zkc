pub input data(address:u16) -> (word:u16)

// prove that two numbers add up to a third.
fn main() {
    var n:u16 = data[0]
    var k:u16 = data[1]
    var res:u32 = data[2] as u32

    pow!(k, n as u32, 1, res)
}

fn pow(i:u16, acc:u32, actual:u32, expected:u32) -> ! {
    var b:u1
    var res:u32
    var j:u16
    // base case
    if i == 0 {
        if actual != expected {
            fail
        } else {
            done
        }
    }
    // recursive case
    // divide by 2
    j::b = i as u17
    // check odd/even
    if b == 1 {
        res = actual * acc
    } else {
        res = actual
    }
    //
    printf "i=%d,acc=%d,res=%d\n", j, acc, res
    //
    pow!(j, acc * acc, res, expected)
}
