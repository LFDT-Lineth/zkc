//error:17:12-13:default case cannot be combined with labels in switch statement

// ================
// shared default
// ================

type exmp = u8

const CASE_A     :exmp = 1
const CASE_MATCH :exmp = 13

fn main() {

  var discr :exmp = CASE_MATCH

  switch discr {
    default, CASE_A: { }
  }
}
