//error:19:5-12:default case must be last in switch statement

// ==============================================
// duplicate default
//    - two consecutive trivial default branches
// ==============================================

type exmp = u8

const CASE_A     :exmp = 1
const CASE_B     :exmp = 2
const CASE_MATCH :exmp = 13

fn main() {

  var discr :exmp = CASE_MATCH

  switch discr {
    default: {}
    default: {}
  }
}
