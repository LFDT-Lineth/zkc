;; one message per bus, each answered on its own bus
{"sndr.S1": [1,0], "sndr.S2": [0,1], "sndr.A": [5,9], "rcvr.R1": [1,0], "rcvr.R2": [0,1], "rcvr.X": [5,9]}
;; same value on both buses simultaneously
{"sndr.S1": [1], "sndr.S2": [1], "sndr.A": [5], "rcvr.R1": [1], "rcvr.R2": [1], "rcvr.X": [5]}
;; both buses empty
{"sndr.S1": [0], "sndr.S2": [0], "sndr.A": [7], "rcvr.R1": [0], "rcvr.R2": [0], "rcvr.X": [7]}
