// ===============================================================================
// Termination Helpers
// ===============================================================================
// failure is a ZkC execution failure (a rejected trace, not a bug); the
// harness recovers it and exits with code 1.
type failure string

func (e failure) Error() string { return string(e) }

func fail(msg string) { panic(failure(msg)) }

// ===============================================================================
// Memory Helpers
// ===============================================================================

func romRead(data []uint64, addr uint64) uint64 {
	if addr >= uint64(len(data)) {
		fail("out-of-bounds read of read-only memory")
	}
	return data[addr]
}

func womWrite(data []uint64, addr uint64, v uint64) []uint64 {
	if addr < uint64(len(data)) && data[addr] != v {
		fail("address already written for write-once memory")
	} else if n := addr + 1; uint64(len(data)) < n {
		data = expand(data, n)
	}
	data[addr] = v
	return data
}

// ensure a given slice has at least n elements
func expand(data []uint64, n uint64) []uint64 {
	return slices.Grow(data, int(n)-len(data))[:n]
}
