	return data[addr]
}

func womWrite(data []uint64, addr uint64, v uint64) []uint64 {
	if addr < uint64(len(data)) && data[addr] != v {
		fail("address already written for write-once memory")
	} else if n := addr + 1; uint64(len(data)) < n {
		data = expand(data, n)
	}
	data[addr] = v
	return data
}

// ramStamp stamps the row holding cells [row*width, end), growing the page as needed.
func ramStamp(stamp uint64, page *RamPage, row, end uint64) {
	if uint64(len(page.data)) < end {
		ramGrow(page, row+1, end)
	}
	page.stamps[row] = stamp
}

// ramGrow ensures a page holds at least the given number of rows and cells.
//
//go:noinline
func ramGrow(page *RamPage, rows, cells uint64) {
	page.data = expand(page.data, cells)
	page.stamps = expand(page.stamps, rows)
}

// ensure a given slice has at least n elements
func expand(data []uint64, n uint64) []uint64 {
	return slices.Grow(data, int(n)-len(data))[:n]
}
