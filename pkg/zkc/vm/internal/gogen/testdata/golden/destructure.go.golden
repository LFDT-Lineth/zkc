	var r1 uint64 // hi
	var r2 uint64 // lo
	var r3 uint64 // $3
	var r4 uint64 // $4
	var r5 uint64 // $5
	// [0.0] ldc $3 = 0x0
	r3 = 0
	// [0.1] read word = args[$3]
